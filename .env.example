# Copia este archivo como .env.local y completa los valores.
# Los encuentras en tu proyecto de Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo se usa en el script de importación del catálogo (scripts/seed.mjs)
# y en operaciones internas de servidor (webhook de Wompi, link de pago).
# NUNCA la pongas en NEXT_PUBLIC_*, ni la subas a un repositorio público.
# La encuentras en Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Wompi (pasarela de pagos) ---
# Los encuentras en tu dashboard de Wompi: Desarrollo -> Programadores ->
# Pagos a terceros. Empieza con las llaves de Sandbox (prefijo pub_test_ /
# test_integrity_ / test_events_) para probar sin dinero real; cuando estés
# listo para producción, reemplázalas por las que empiezan pub_prod_ / etc.
# Ninguna de estas se expone al navegador — todas se usan solo en el servidor.
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_INTEGRITY_SECRET=test_integrity_tu_secreto_de_integridad
WOMPI_EVENTS_SECRET=test_events_tu_secreto_de_eventos
