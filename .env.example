# Copia este archivo como .env.local y completa los valores.
# Los encuentras en tu proyecto de Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo se usa en el script de importación del catálogo (scripts/seed.mjs)
# y en operaciones internas de servidor (webhook de Wompi, link de pago).
# NUNCA la pongas en NEXT_PUBLIC_*, ni la subas a un repositorio público.
# La encuentras en Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Wompi (pasarela de pagos) ---
# Los encuentras en tu dashboard de Wompi: Desarrollo -> Programadores ->
# Pagos a terceros. Empieza con las llaves de Sandbox (prefijo pub_test_ /
# test_integrity_ / test_events_) para probar sin dinero real; cuando estés
# listo para producción, reemplázalas por las que empiezan pub_prod_ / etc.
# Ninguna de estas se expone al navegador — todas se usan solo en el servidor.
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_INTEGRITY_SECRET=test_integrity_tu_secreto_de_integridad
WOMPI_EVENTS_SECRET=test_events_tu_secreto_de_eventos

# --- Meta Pixel (Facebook/Instagram Ads) ---
# Lo encuentras en Meta Business Suite -> Administrador de eventos -> tu píxel.
# Este SÍ se expone al navegador (así funciona el píxel), por eso lleva NEXT_PUBLIC_.
NEXT_PUBLIC_META_PIXEL_ID=tu_pixel_id

# Opcional pero recomendado: token de acceso para Conversion API (envío del
# evento "Purchase" también desde el servidor, más confiable). Se genera en
# Administrador de eventos -> tu píxel -> Configuración -> Conversion API ->
# "Generar token de acceso". Si lo dejas vacío, el píxel del navegador sigue
# funcionando igual, solo no se envía el respaldo por servidor.
META_CONVERSION_API_TOKEN=

# --- SEO ---
# Tu dominio real (sin barra al final). Se usa para el sitemap, robots.txt,
# y las URLs "canónicas"/de compartir en redes. Cuando conectes tu dominio
# propio, cámbialo aquí (ej: https://prestigeimportaciones.com).
NEXT_PUBLIC_SITE_URL=https://prestige-importaciones.vercel.app

# --- Notificaciones por correo (Resend) ---
# Te avisa por correo cada vez que llega un pedido nuevo, y cuando un pago
# con tarjeta/PSE se confirma o se rechaza. Crea una cuenta gratis en
# resend.com, saca tu API Key en el dashboard, y pon aquí a qué correo
# quieres que te lleguen los avisos. Si dejas cualquiera de los dos vacío,
# simplemente no se envían notificaciones (no rompe nada).
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
